// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

model Package {
  id          String   @id @default(cuid())
  name        String
  price       Int
  description String?
  features    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model Template {
  id           String   @id @default(cuid())
  name         String
  category     String
  thumbnailUrl String?
  previewUrl   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  invitations  Invitation[]
}

model Order {
  id             String      @id @default(cuid())
  customerName   String
  customerEmail  String
  customerPhone  String
  packageId      String
  package        Package     @relation(fields: [packageId], references: [id])
  status         OrderStatus @default(PENDING)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  invitation     Invitation?
  payment        Payment?
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED
}

model Invitation {
  id           String    @id @default(cuid())
  orderId      String    @unique
  order        Order     @relation(fields: [orderId], references: [id])
  templateId   String
  template     Template  @relation(fields: [templateId], references: [id])
  slug         String    @unique
  brideName    String
  groomName    String
  eventDate    DateTime
  akadTime     String?
  akadVenue    String?
  resepsiTime  String?
  resepsiVenue String?
  mapsUrl      String?
  musicUrl     String?
  bankName     String?
  bankAccount  String?
  bankHolder   String?
  isActive     Boolean   @default(true)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  galleries    Gallery[]
  rsvps        Rsvp[]
  wishes       Wish[]
}

model Gallery {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id])
  url          String
  caption      String?
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
}

model Rsvp {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id])
  guestName    String
  attending    Boolean
  guestCount   Int        @default(1)
  message      String?
  createdAt    DateTime   @default(now())
}

model Wish {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id])
  name         String
  message      String
  createdAt    DateTime   @default(now())
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  amount        Int
  method        String?
  status        PaymentStatus @default(PENDING)
  transactionId String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
